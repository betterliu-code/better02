<mxfile host="app.diagrams.net">
  <diagram name="系统结构与技术路线" id="sys">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="校园生活助手 APP — 系统结构与技术路线图" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ui" value="用户交互层 (UI)&#10;MainActivity + BottomNavigationView" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="120" y="70" width="610" height="170" as="geometry" />
        </mxCell>
        <mxCell id="home" value="HomeFragment&#10;首页" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="150" y="140" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="notice" value="NoticeFragment&#10;公告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="345" y="140" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="profile" value="ProfileFragment&#10;我的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="540" y="140" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="save" value="本地数据保存层&#10;SharedPreferences&#10;（多字段持久化）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="320" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="data" value="资源 / 数据读取层&#10;assets/notices.json&#10;NoticeRepository（JSON 解析）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="320" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="service" value="服务 / 提醒层&#10;ReminderService（后台读数据）&#10;→ sendBroadcast()&#10;→ ReminderReceiver&#10;→ Notification（系统通知）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="470" width="270" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="保存 / 回显" style="endArrow=classic;startArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="ui" target="save">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="读取 / 解析" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="ui" target="data">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="提供数据" style="endArrow=classic;html=1;fontSize=11;" edge="1" parent="1" source="data" target="service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="设为提醒 / 课程提醒" style="endArrow=classic;html=1;fontSize=11;dashed=1;" edge="1" parent="1" source="notice" target="service">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
